# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site (usado nos links e no login por e-mail)
# Em produção: https://campia.app.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamentos: "mock" (simulado, para desenvolvimento) ou "asaas"
PAYMENT_PROVIDER=mock
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que você define ao criar o webhook no painel da Asaas (32 a 255 caracteres)
ASAAS_WEBHOOK_TOKEN=

# Notificações (Web Push). Gere as chaves com: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@campia.app.br
# Segredo do agendador que chama /api/cron/lembretes
CRON_SECRET=

# Repasse automático (split da Asaas): % do valor líquido de cada inscrição que fica com a Campia.
# O restante vai direto para a conta Asaas do organizador que conectou a conta em Painel › Recebimentos.
CAMPIA_TAXA_PERCENT=10

# CNPJ da empresa responsável, exibido nos Termos de Uso e na Política de Privacidade.
NEXT_PUBLIC_EMPRESA_CNPJ=
