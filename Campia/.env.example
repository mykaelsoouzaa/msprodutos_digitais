# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site (usado nos links e no login por e-mail)
# Em produção: https://campia.app.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamentos: "mock" (simulado, para desenvolvimento) ou "asaas"
PAYMENT_PROVIDER=mock
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que você define ao criar o webhook no painel da Asaas (32 a 255 caracteres)
ASAAS_WEBHOOK_TOKEN=

# Notificações (Web Push). Gere as chaves com: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@campia.app.br
# Segredo do agendador que chama /api/cron/lembretes
CRON_SECRET=

# Repasse automático (split da Asaas): % do valor líquido de cada inscrição que fica com a Campia.
# O restante vai direto para a conta Asaas do organizador que conectou a conta em Painel › Recebimentos.
CAMPIA_TAXA_PERCENT=10
# Plano Pro: mensalidade em reais e taxa menor por inscrição para quem assina
CAMPIA_PRO_PRECO=49.90
CAMPIA_TAXA_PERCENT_PRO=5
# WhatsApp oficial (opcional, Meta WhatsApp Cloud API). Vazio = desligado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Nomes dos modelos aprovados na Meta (padrão abaixo)
WHATSAPP_TEMPLATE_JOGO=campia_lembrete_jogo
WHATSAPP_TEMPLATE_PIX=campia_pagamento_pendente

# CNPJ da empresa responsável, exibido nos Termos de Uso e na Política de Privacidade.
NEXT_PUBLIC_EMPRESA_CNPJ=

# E-mails do dono da plataforma (separados por vírgula): acessam /admin.
ADMIN_EMAILS=contato@campia.app.br

# Lembrete por e-mail do PIX pendente: chave de API do Brevo (SMTP & API › API Keys). Sem ela, o lembrete não sai.
BREVO_API_KEY=
EMAIL_FROM=naoresponda@campia.app.br
