# Copie para .env e preencha.
PORTA=3200
# Fuso usado na janela de envio, nos horários automáticos e no resumo diário
TZ=America/Sao_Paulo
# Endereço público (links de entrada /g/, vitrine /v/, links curtos /r/ e a página de vendas)
URL_PUBLICA=https://ofertix.cloud
BANCO=/srv/ms/dados/ofertix.db

# Gere com: openssl rand -hex 32
SEGREDO_SESSAO=

# Entrada pela área do cliente (mesma chave pública que a Nina usa), em uma linha com \n
PORTAL_URL=https://mssolucoestech.com.br
PORTAL_CHAVE_PUBLICA=

# Evolution API (WhatsApp por QR Code), instalada na própria VPS
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=

# Quem vê a Administração do Ofertix (separe por vírgula)
ADMIN_EMAILS=voce@exemplo.com
